% jmlr2e-minimal.sty
% Minimal JMLR style implementation - use if official jmlr2e.sty unavailable
% Place this file in same directory as your .tex file

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jmlr2e-minimal}[2025/01/01 Minimal JMLR Style]

% Page layout
\RequirePackage[letterpaper,margin=1in,twoside]{geometry}
\RequirePackage{fancyhdr}

% Typography
\RequirePackage{times}
\RequirePackage{mathptmx}
\RequirePackage[T1]{fontenc}

% Essential packages
\RequirePackage{natbib}
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{algorithm,algorithmic}
\RequirePackage{url}
\RequirePackage{hyperref}

% JMLR-specific commands
\newcommand{\jmlrheading}[7]{%
  \def\jmlrvolume{#1}%
  \def\jmlryear{#2}%
  \def\jmlrpages{#3}%
  \def\jmlrsubmitted{#4}%
  \def\jmlrpublished{#5}%
  \def\jmlrauthors{#6}%
}

\newcommand{\ShortHeadings}[2]{%
  \def\leftmark{#1}%
  \def\rightmark{#2}%
}

\newcommand{\firstpageno}[1]{\setcounter{page}{#1}}

% Header/Footer setup
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\thepage\quad\leftmark}
\fancyhead[RO]{\small\rightmark\quad\thepage}
\renewcommand{\headrulewidth}{0pt}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE\bfseries\@title\par}%
    \vskip 2em%
    {\large\@author\par}%
    \vskip 1em%
    {\large\@date\par}%
  \end{center}%
  \vskip 1.5em%
}

% Author block
\renewcommand{\author}[1]{%
  \gdef\@author{#1}%
}

\newcommand{\name}{}
\newcommand{\email}[1]{\texttt{#1}}
\newcommand{\addr}{}

% Editor
\newcommand{\editor}[1]{\gdef\@editor{#1}}

% Abstract environment
\renewenvironment{abstract}{%
  \small
  \begin{center}%
    \bfseries Abstract%
  \end{center}%
  \quotation
}{%
  \endquotation
}

% Keywords
\newcommand{\keywords}[1]{%
  \par\vskip 1em%
  \noindent\textbf{Keywords:} #1%
}

% Section formatting
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Bibliography style
\bibliographystyle{plainnat}
\bibpunct{(}{)}{;}{a}{,}{,}

% Theorem environments
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% Spacing
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}

\endinput
