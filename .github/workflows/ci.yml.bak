name: CI/CD Pipeline

on:
  push:
    branches: [ master, develop, 'feature/*' ]
  pull_request:
    branches: [ master, develop ]
  workflow_dispatch:

env:
  HYPATIAX_ROOT: ${{ github.workspace }}
  PYTHONPATH: ${{ github.workspace }}
  HYPATIAX_OUTPUT_DIR: ${{ github.workspace }}/ci_outputs

jobs:
  # =============================================================================
  # SETUP & VALIDATION
  # =============================================================================
  setup:
    name: Setup & Validate
    runs-on: ubuntu-latest
    outputs:
      project_root: ${{ steps.setup.outputs.project_root }}
      has_changes: ${{ steps.changes.outputs.has_changes }}
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    - name: Check for changes
      id: changes
      run: |
        if git diff --quiet HEAD~1 HEAD -- 'hypatiax/**' 'tests/**' 'requirements*.txt'; then
          echo "has_changes=false" >> $GITHUB_OUTPUT
        else
          echo "has_changes=true" >> $GITHUB_OUTPUT
        fi
    
    - name: Setup environment
      id: setup
      run: |
        chmod +x setup_environment.sh
        ./setup_environment.sh || true
        echo "project_root=${{ github.workspace }}" >> $GITHUB_OUTPUT
    
    - name: Validate structure
      run: |
        test -d hypatiax || { echo "❌ hypatiax/ not found"; exit 1; }
        test -d hypatiax/datasets || { echo "❌ datasets not found"; exit 1; }
        test -f hypatiax/config/config.py || { echo "❌ config.py not found"; exit 1; }
        echo "✅ Structure validated"

  # =============================================================================
  # LINT & FORMAT
  # =============================================================================
  lint:
    name: Code Quality
    runs-on: ubuntu-latest
    needs: setup
    if: needs.setup.outputs.has_changes == 'true'
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up Python 3.12
      uses: actions/setup-python@v5
      with:
        python-version: '3.12'
        cache: 'pip'
    
    - name: Install linting tools
      run: |
        pip install black flake8 isort mypy pylint
    
    - name: Run black
      run: black --check hypatiax/ tests/ || true
    
    - name: Run flake8
      run: flake8 hypatiax/ tests/ --max-line-length=100 || true
    
    - name: Run mypy
      run: mypy hypatiax/ || true

  # =============================================================================
  # BUILD
  # =============================================================================
  build:
    name: Build Distribution
    needs: [setup, lint]
    runs-on: ubuntu-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up Python 3.12
      uses: actions/setup-python@v5
      with:
        python-version: '3.12'
        cache: 'pip'
    
    - name: Build package
      run: |
        pip install build wheel setuptools
        python -m build
    
    - name: Upload artifacts
      uses: actions/upload-artifact@v4
      with:
        name: python-package
        path: dist/
        retention-days: 30

  # =============================================================================
  # TEST MATRIX
  # =============================================================================
  test:
    name: Test Python ${{ matrix.python-version }}
    needs: build
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.12', '3.13']
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up Python ${{ matrix.python-version }}
      uses: actions/setup-python@v5
      with:
        python-version: ${{ matrix.python-version }}
        cache: 'pip'
    
    - name: Download artifacts
      uses: actions/download-artifact@v4
      with:
        name: python-package
        path: dist/
    
    - name: Install dependencies
      run: |
        pip install pytest pytest-cov pytest-timeout
        PYVERSION=$(python -c "import sys; print(f'{sys.version_info.major}{sys.version_info.minor}')")
        REQ_FILE="requirements-py${PYVERSION}.txt"
        
        if [ -f "$REQ_FILE" ]; then
          pip install -r "$REQ_FILE"
        else
          pip install -r requirements.txt
        fi
    
    - name: Install package
      run: pip install dist/*.whl
    
    - name: Run tests
      run: |
        mkdir -p ci_outputs
        pytest tests/ -v --cov=hypatiax --cov-report=xml --cov-report=html
    
    - name: Upload coverage
      uses: codecov/codecov-action@v4
      if: matrix.python-version == '3.12'
      with:
        file: ./coverage.xml
        fail_ci_if_error: false
    
    - name: Upload test results
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: test-results-py${{ matrix.python-version }}
        path: |
          ci_outputs/
          htmlcov/
          .coverage
        retention-days: 7

  # =============================================================================
  # INTEGRATION TESTS
  # =============================================================================
  integration:
    name: Integration Tests
    needs: test
    runs-on: ubuntu-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up Python 3.12
      uses: actions/setup-python@v5
      with:
        python-version: '3.12'
    
    - name: Install package
      run: pip install -e .
    
    - name: Run integration tests
      run: |
        python -c "from hypatiax.config import config; assert config.root.exists()"
        
        if [ -f "tests/test_entity_desc.py" ]; then
          python tests/test_entity_desc.py
        fi
        
        if [ -f "tests/test_entity_formulas.py" ]; then
          python tests/test_entity_formulas.py
        fi

  # =============================================================================
  # PUBLISH (only on tags)
  # =============================================================================
  publish:
    name: Publish to PyPI
    needs: [test, integration]
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/')
    environment:
      name: pypi
      url: https://pypi.org/p/hypatiax
    permissions:
      id-token: write
    
    steps:
    - name: Download artifacts
      uses: actions/download-artifact@v4
      with:
        name: python-package
        path: dist/
    
    - name: Publish to PyPI
      uses: pypa/gh-action-pypi-publish@release/v1
