class TestIntegrationScenarios:
    """Test integration scenarios (8 tests)"""

    def test_defi_domain_integration(self):
        """Integration with DeFi domain"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="price * volume",
            variable_definitions={"price": "token_price", "volume": "trading_volume"},
            variable_units={"price": "USD", "volume": "tokens"},
        )
        assert "valid" in result
        assert result["domain"] == "defi"

    def test_multi_variable_complex_expression(self):
        """Complex expression with multiple variables"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="(a + b) / (c - d)",
            variable_definitions={"a": "val1", "b": "val2", "c": "val3", "d": "val4"},
            variable_units={"a": "USD", "b": "USD", "c": "units", "d": "units"},
        )
        assert "valid" in result

    def test_expression_with_functions(self):
        """Expression with mathematical functions"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="sqrt(x**2 + y**2)",
            variable_definitions={"x": "value_x", "y": "value_y"},
            variable_units={"x": "USD", "y": "USD"},
        )
        assert "valid" in result

    def test_dimensional_analysis_integration(self):
        """Integration with dimensional analysis"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="price * quantity",
            variable_definitions={"price": "unit_price", "quantity": "amount"},
            variable_units={"price": "USD/token", "quantity": "tokens"},
        )
        assert "valid" in result

    def test_validation_history_tracking(self):
        """Track validation history"""
        validator = EnsembleValidator(domain="defi")
        validator.validate_complete(
            expression_str="x + y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "USD"},
        )
        validator.validate_complete(
            expression_str="x * y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "units"},
        )
        assert len(validator.validation_history) == 2

    def test_statistics_calculation(self):
        """Calculate validation statistics"""
        validator = EnsembleValidator(domain="defi")
        for i in range(5):
            validator.validate_complete(
                expression_str=f"x + {i}",
                variable_definitions={"x": "value"},
                variable_units={"x": "USD"},
            )
        stats = validator.get_statistics()
        assert "total_validations" in stats
        assert stats["total_validations"] == 5

    def test_recommendations_generation(self):
        """Generate recommendations for improvements"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x / y",
            variable_definitions={"x": "numerator", "y": "denominator"},
            variable_units={"x": "USD", "y": "ETH"},
        )
        assert "recommendations" in result
        assert len(result["recommendations"]) > 0

    def test_cross_domain_validation_attempt(self):
        """Attempt validation across domains"""
        validator_defi = EnsembleValidator(domain="defi")
        result = validator_defi.validate_complete(
            expression_str="temperature * pressure",
            variable_definitions={"temperature": "temp", "pressure": "press"},
            variable_units={"temperature": "kelvin", "pressure": "pascal"},
        )
        assert "valid" in result


