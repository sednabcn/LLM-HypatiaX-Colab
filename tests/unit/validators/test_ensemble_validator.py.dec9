        """Multiple edge case types handled correctly"""
        validator = EnsembleValidator(domain="defi")
        result = validator._check_acceptance_criteria(
            total_score=75.0,
            symbolic={"valid": True, "score": 85.0},
            dimensional={"valid": True, "score": 80.0},
            domain={"valid": True, "score": 80.0},
            edge_cases=["WARNING: Issue 1", "WARNING: Issue 2", "WARNING: Issue 3"],
        )
        assert result is False

    def test_critical_threshold_50(self):
        """Scores below 50 should be critical failure"""
        validator = EnsembleValidator(domain="defi")
        result = validator._check_acceptance_criteria(
            total_score=45.0,
            symbolic={"valid": False, "score": 40.0},
            dimensional={"valid": False, "score": 45.0},
            domain={"valid": False, "score": 50.0},
            edge_cases=["CRITICAL: Multiple failures"],
        )
        assert result is False


