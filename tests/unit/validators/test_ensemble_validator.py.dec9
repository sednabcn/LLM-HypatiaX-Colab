class TestPerformanceStress:
    """Test performance and stress scenarios (6 tests)"""

    def test_large_number_of_variables(self):
        """Handle expression with many variables"""
        validator = EnsembleValidator(domain="defi")
        var_defs = {f"x{i}": f"var{i}" for i in range(20)}
        var_units = {f"x{i}": "USD" for i in range(20)}
        expr = " + ".join([f"x{i}" for i in range(20)])

        result = validator.validate_complete(
            expression_str=expr,
            variable_definitions=var_defs,
            variable_units=var_units,
        )
        assert "valid" in result

    def test_deeply_nested_expression(self):
        """Handle deeply nested expressions"""
        validator = EnsembleValidator(domain="defi")
        expr = "x"
        for _ in range(10):
            expr = f"({expr} + y)"

        result = validator.validate_complete(
            expression_str=expr,
            variable_definitions={"x": "val1", "y": "val2"},
            variable_units={"x": "USD", "y": "USD"},
        )
        assert "valid" in result

    def test_multiple_consecutive_validations(self):
        """Handle multiple consecutive validations"""
        validator = EnsembleValidator(domain="defi")
        for i in range(10):
            result = validator.validate_complete(
                expression_str=f"x * {i+1}",
                variable_definitions={"x": "value"},
                variable_units={"x": "USD"},
            )
            assert "valid" in result

    def test_validation_with_extreme_values(self):
        """Handle validation with extreme values"""
        validator = EnsembleValidator(domain="defi")
        result = validator._check_acceptance_criteria(
            total_score=99.999,
            symbolic={"valid": True, "score": 99.9},
            dimensional={"valid": True, "score": 99.9},
            domain={"valid": True, "score": 99.9},
            edge_cases=[],
        )
        assert result

# ============================================================================
# TEST CLASS 14 CONTINUATION: Performance and Stress Tests (2 remaining tests)
# ============================================================================

    def test_concurrent_edge_case_detection(self):
        """Handle multiple edge cases simultaneously"""
        validator = EnsembleValidator(domain="defi")
        symbolic_result = {
            "valid": False,
            "score": 40.0,
            "errors": ["Division by zero", "Empty expression", "Syntax error"]
        }
        dimensional_result = {
            "valid": False,
            "score": 50.0,
            "errors": ["Dimensional inconsistency", "Unit mismatch"]
        }
        domain_result = {
            "valid": False,
            "score": 45.0,
            "errors": ["Domain constraint violation"]
        }
        numerical_result = {
            "score": 30.0,
            "errors": ["NaN production", "Infinite values"],
            "warnings": ["Overflow risk"]
        }

        edge_cases = validator._detect_edge_cases(
            symbolic_result, dimensional_result, domain_result, numerical_result
        )
        assert len(edge_cases) >= 5

    def test_validation_result_completeness(self):
        """Ensure validation results contain all required fields"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x + y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "USD"},
        )

        required_fields = [
            "valid", "total_score", "layer_results", "edge_cases",
            "penalties", "recommendations", "domain"
        ]
        for field in required_fields:
            assert field in result


# ============================================================================
# TEST CLASS 15: Score Calculation and Validation Results (10 tests)
# ============================================================================


class TestScoreCalculationAndResults:
    """Test score calculation and validation result formatting (10 tests)"""

    def test_weighted_score_calculation_accuracy(self):
        """Weighted score should be calculated accurately"""
        validator = EnsembleValidator(domain="defi")
        symbolic_score = 90.0
        dimensional_score = 80.0
        domain_score = 85.0
        numerical_score = 95.0

        expected = (
            symbolic_score * 0.30 +
            dimensional_score * 0.30 +
            domain_score * 0.30 +
            numerical_score * 0.10
        )

        # Calculate actual weighted score
        weighted = (
            symbolic_score * validator.weights["symbolic"] +
            dimensional_score * validator.weights["dimensional"] +
            domain_score * validator.weights["domain"] +
            numerical_score * validator.weights["numerical"]
        )

        assert np.isclose(weighted, expected)
        assert np.isclose(weighted, 86.0)

    def test_score_components_in_result(self):
        """Result should contain all score components"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x * y",
            variable_definitions={"x": "price", "y": "volume"},
            variable_units={"x": "USD", "y": "units"},
        )

        assert "layer_results" in result
        assert "symbolic" in result["layer_results"]
        assert "dimensional" in result["layer_results"]
        assert "domain" in result["layer_results"]
        assert "numerical" in result["layer_results"]

        for layer in ["symbolic", "dimensional", "domain"]:
            assert "score" in result["layer_results"][layer]

    def test_penalty_breakdown_in_result(self):
        """Result should contain penalty breakdown"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x / 0",
            variable_definitions={"x": "value"},
            variable_units={"x": "USD"},
        )

        assert "penalties_applied" in result
        assert "edge_case_penalty" in result["penalties"]
        assert "low_layer_penalty" in result["penalties"]

    def test_recommendations_provided_for_failures(self):
        """Recommendations should be provided for failures"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x + y",
            variable_definitions={"x": "price", "y": "volume"},
            variable_units={"x": "USD", "y": "ETH"},
        )

        if not result["valid"]:
            assert "recommendations" in result
            assert len(result["recommendations"]) > 0

    def test_edge_cases_list_structure(self):
        """Edge cases should be properly structured"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x / y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "units"},
        )

        assert "edge_cases_detected" in result
        assert isinstance(result["edge_cases_detected"], list)
        for case in result["edge_cases_detected"]:
            assert isinstance(case, str)

    def test_validation_metadata_included(self):
        """Validation metadata should be included"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x + y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "USD"},
        )

        assert "domain" in result
        assert result["domain"] == "defi"
        assert "total_score" in result
        assert isinstance(result["total_score"], (int, float))

    def test_score_range_validation(self):
        """Scores should be within valid ranges"""
        validator = EnsembleValidator(domain="defi")
        result = validator.validate_complete(
            expression_str="x * 2",
            variable_definitions={"x": "value"},
            variable_units={"x": "USD"},
        )

        assert 0.0 <= result["total_score"] <= 100.0
        for layer in ["symbolic", "dimensional", "domain", "numerical"]:
            if layer in result["layer_results"]:
                score = result["layer_results"][layer].get("score", 0)
                assert 0.0 <= score <= 100.0

    def test_valid_flag_consistency(self):
        """Valid flag should be consistent with scores and errors"""
        validator = EnsembleValidator(domain="defi")

        # Test passing case
        result_pass = validator._check_acceptance_criteria(
            total_score=90.0,
            symbolic={"valid": True, "score": 92.0},
            dimensional={"valid": True, "score": 90.0},
            domain={"valid": True, "score": 88.0},
            edge_cases=[],
        )
        assert result_pass is True

        # Test failing case
        result_fail = validator._check_acceptance_criteria(
            total_score=80.0,
            symbolic={"valid": True, "score": 82.0},
            dimensional={"valid": True, "score": 80.0},
            domain={"valid": True, "score": 78.0},
            edge_cases=[],
        )
        assert result_fail is False

    def test_layer_validity_affects_overall_validity(self):
        """Layer validity should properly affect overall validity"""
        validator = EnsembleValidator(domain="defi")

        # All valid layers
        result1 = validator._check_acceptance_criteria(
            total_score=88.0,
            symbolic={"valid": True, "score": 90.0},
            dimensional={"valid": True, "score": 88.0},
            domain={"valid": True, "score": 86.0},
            edge_cases=[],
        )
        assert result1 is True

        # One invalid layer
        result2 = validator._check_acceptance_criteria(
            total_score=88.0,
            symbolic={"valid": False, "score": 65.0},
            dimensional={"valid": True, "score": 95.0},
            domain={"valid": True, "score": 90.0},
            edge_cases=[],
        )
        assert result2 is False

    def test_statistics_accuracy(self):
        """Validation statistics should be accurate"""
        validator = EnsembleValidator(domain="defi")

        # Run 3 validations
        validator.validate_complete(
            expression_str="x + y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "USD"},
        )
        validator.validate_complete(
            expression_str="x / 0",
            variable_definitions={"x": "a"},
            variable_units={"x": "USD"},
        )
        validator.validate_complete(
            expression_str="x * y",
            variable_definitions={"x": "a", "y": "b"},
            variable_units={"x": "USD", "y": "units"},
        )

        stats = validator.get_statistics()
        assert stats["total_validations"] == 3
        assert "pass_rate" in stats or "passed" in stats


