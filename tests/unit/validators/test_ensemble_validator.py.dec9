        """Handle scores above 100"""
        validator = EnsembleValidator(domain="defi")
        result = validator._check_acceptance_criteria(
            total_score=105.0,
            symbolic={"valid": True, "score": 105.0},
            dimensional={"valid": True, "score": 105.0},
            domain={"valid": True, "score": 105.0},
            edge_cases=[],
        )
