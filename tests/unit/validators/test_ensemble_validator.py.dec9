    def test_all_layers_must_be_valid(self):
        """All layers must be valid for acceptance"""
        validator = EnsembleValidator(domain="defi")
        for layer in ["symbolic", "dimensional", "domain"]:
            layers = {"symbolic": {"valid": True, "score": 90.0},
                     "dimensional": {"valid": True, "score": 90.0},
                     "domain": {"valid": True, "score": 90.0}}
            layers[layer] = {"valid": False, "score": 65.0}

            result = validator._check_acceptance_criteria(
                total_score=87.0,
                symbolic=layers["symbolic"],
                dimensional=layers["dimensional"],
                domain=layers["domain"],
                edge_cases=[],
            )
            assert result is False

    def test_high_score_with_one_invalid_layer_fails(self):
        """Even high scores fail if one layer invalid"""
        validator = EnsembleValidator(domain="defi")
        result = validator._check_acceptance_criteria(
            total_score=92.0,
            symbolic={"valid": False, "score": 60.0},
            dimensional={"valid": True, "score": 98.0},
            domain={"valid": True, "score": 95.0},
            edge_cases=[],
        )
