        .layer-engine { background: #f3e5f5; }
        .layer-decision { background: #e8f5e9; }
        .layer-validation { background: #fff3e0; }
        .layer-interpretation { background: #ffebee; }
        .layer-optional { background: #fff9c4; }
        .layer-llm-guided { background: #e1f5fe; }

        .layer-highlight {
            position: relative;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4); }
            50% { box-shadow: 0 0 0 8px rgba(102, 126, 234, 0); }
        }

        .layer-content {
            padding: 12px 15px;
            background: white;
        }

        .component {
            padding: 6px 10px;
            margin: 4px 0;
            background: #f8f9fa;
            border-left: 3px solid #667eea;
            border-radius: 4px;
            font-size: 0.9em;
        }

        .component.missing {
            border-left-color: #dc3545;
            color: #721c24;
            background: #f8d7da;
        }

        .component.warning {
            border-left-color: #ffc107;
            color: #856404;
            background: #fff3cd;
        }

        .component.success {
            border-left-color: #28a745;
            color: #155724;
            background: #d4edda;
        }

        .time-badge {
            font-size: 0.8em;
            padding: 2px 8px;
            background: #e9ecef;
            border-radius: 10px;
            color: #6c757d;
        }

        .interpretation-box {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

        .interpretation-title {
            font-weight: bold;
            margin-bottom: 10px;
            color: #667eea;
            font-size: 1.1em;
        }

        .interpretation-item {
            margin: 8px 0;
            font-size: 0.9em;
        }

        .interpretation-item strong {
            display: inline-block;
            width: 120px;
            color: #495057;
        }

        .comparison-table {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            margin-top: 20px;
            overflow-x: auto;
        }

        .comparison-table h2 {
            margin-bottom: 15px;
            color: #667eea;
        }

        .comparison-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .comparison-table th {
            background: #667eea;
            color: white;
            padding: 12px;
            text-align: left;
        }

        .comparison-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #e9ecef;
        }

        .comparison-table tr:hover {
            background: #f8f9fa;
        }

        .status-icon {
            font-size: 1.2em;
        }

        .flow-diagram {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            margin-top: 20px;
