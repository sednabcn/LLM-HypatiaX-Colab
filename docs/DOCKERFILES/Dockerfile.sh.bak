# Multi-stage Dockerfile for HypatiaX
# Supports Python 3.12 (Stable) and 3.13 (Latest)

# =============================================================================
# Base stage - Common setup for all Python versions
# =============================================================================
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim as base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /workspace/hypatiax

# =============================================================================
# Development stage - For interactive development
# =============================================================================
FROM base as development

# Install additional dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    nano \
    tmux \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /workspace/hypatiax/

# Upgrade pip and install build tools
RUN pip install --upgrade pip setuptools wheel

# Install pip-audit for security scanning
RUN pip install pip-audit safety

# Install project dependencies
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

# Install project in editable mode
RUN pip install -e .

# Run setup script
RUN chmod +x setup_environment.sh && ./setup_environment.sh

# Expose ports (if running Jupyter or web apps)
EXPOSE 8888 8000

# Default command
CMD ["/bin/bash"]

# =============================================================================
# Testing stage - For CI/CD
# =============================================================================
FROM base as testing

# Copy project files
COPY . /workspace/hypatiax/

# Install dependencies
RUN pip install --upgrade pip setuptools wheel
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
RUN if [ -f requirements-test.txt ]; then pip install -r requirements-test.txt; fi

# Install testing tools
RUN pip install pytest pytest-cov pytest-xdist

# Install project
RUN pip install -e .

# Run setup
RUN chmod +x setup_environment.sh && ./setup_environment.sh

# Run tests by default
CMD ["pytest", "tests/", "-v", "--cov=hypatiax"]

# =============================================================================
# Production stage - Minimal image for deployment
# =============================================================================
FROM base as production

# Copy only necessary files
COPY hypatiax/ /workspace/hypatiax/hypatiax/
COPY setup.py /workspace/hypatiax/
COPY README.md /workspace/hypatiax/
COPY setup_environment.sh /workspace/hypatiax/

# Install production dependencies only
RUN pip install --upgrade pip setuptools wheel
COPY requirements.txt /workspace/hypatiax/
RUN pip install --no-cache-dir -r requirements.txt

# Install project
RUN pip install --no-cache-dir .
RUN chmod +x setup_environment.sh && ./setup_environment.sh

# Create non-root user for security
RUN useradd -m -u 1000 hypatiax && \
    chown -R hypatiax:hypatiax /workspace/hypatiax

USER hypatiax

# Set entrypoint
ENTRYPOINT ["python"]
CMD ["-m", "hypatiax"]
