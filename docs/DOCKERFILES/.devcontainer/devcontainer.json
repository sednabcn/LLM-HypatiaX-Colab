{
  "name": "HypatiaX Python 3.12 (Stable)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "development",
    "args": {
      "PYTHON_VERSION": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.pytest_cache": true,
          "**/outputs": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter",
        "GitHub.copilot",
        "eamodio.gitlens"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -e . && ./setup_environment.sh",
  "remoteEnv": {
    "HYPATIAX_ENV": "codespace",
    "PYTHONPATH": "/workspace/hypatiax",
    "HYPATIAX_ROOT": "/workspace/hypatiax"
  },
  "forwardPorts": [8888, 8000],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Web App",
      "onAutoForward": "notify"
    }
  }
}
