# ============================================================================
# config/validation_thresholds.yaml
# Centralized validation threshold configuration
# ============================================================================

validation_thresholds:
  # Minimum total score for formula acceptance
  minimum_total_score: 85.0

  # Edge case detection penalties
  edge_case_penalties:
    empty_expression: 15.0
    division_by_zero: 15.0
    overflow_risk: 10.0
    underflow_risk: 10.0
    invalid_domain: 15.0
    unbounded_exponential: 10.0

  # Dimensional inconsistency penalties
  dimensional_penalties:
    major_inconsistency: 20.0      # Units don't match at all
    minor_inconsistency: 10.0      # Units convertible but not ideal
    missing_units: 5.0

  # Validation layer weights
  layer_weights:
    symbolic: 0.30      # Increased from 0.35 (Week 2 update)
    dimensional: 0.30   # Increased from 0.25 (Week 2 update)
    domain: 0.25
    completeness: 0.15

  # Domain-specific thresholds
  domain_thresholds:
    defi:
      minimum_score: 85.0
      quality_score_excellent: 2.0    # QS > 2.0 (USDT/USDC example)
      quality_score_poor: 0.5         # QS < 0.5 (SHIB/USDC example)

    physics:
      minimum_score: 85.0
      dimensional_precision: 0.95

    chemistry:
      minimum_score: 85.0
      unit_consistency_required: true

  # Acceptance criteria
  acceptance_criteria:
    minimum_symbolic_score: 70.0
    minimum_dimensional_score: 70.0
    minimum_domain_score: 70.0
    no_critical_edge_cases: true
    dimensional_consistent: true
    constraints_validated: true

# Constraint requirements by operation
operation_constraints:
  division:
    required: ["denominator != 0"]
    recommended: ["denominator > epsilon"]
    epsilon: 1.0e-10

  sqrt:
    required: ["argument >= 0"]
    recommended: ["argument > epsilon"]

  log:
    required: ["argument > 0"]
    recommended: ["argument > epsilon"]

  exp:
    required: []
    recommended: ["argument bounded", "-10 < arg < 10"]

  power:
    required: []
    recommended: ["base bounded if exponent > 10"]

# Domain-specific constraints
domain_constraints:
  defi:
    price:
      required: ["price > 0"]
      typical_range: [1.0e-10, 1.0e12]

    ratio:
      required: ["ratio > 0"]
      typical_range: [0.1, 10.0]

    fee:
      required: ["0 < fee < 1"]
      typical_range: [0.0001, 0.01]

    volatility:
      required: ["volatility >= 0"]
      typical_range: [0.0, 10.0]

  physics:
    mass:
      required: ["mass > 0"]
      typical_range: [1.0e-30, 1.0e30]

    velocity:
      required: ["velocity >= 0", "velocity < c"]
      c: 299792458  # Speed of light (m/s)

    temperature:
      required: ["temperature > 0"]  # Kelvin
      typical_range: [0.01, 5000]

  chemistry:
    concentration:
      required: ["concentration > 0"]
      typical_range: [1.0e-10, 100]
      units: "M"

    rate_constant:
      required: ["k > 0"]
      typical_range: [1.0e-10, 1.0e10]

    temperature:
      required: ["T > 0"]
      typical_range: [200, 500]

---

# ============================================================================
# config/llm_provider_config.yaml
# LLM provider configuration for Anthropic Claude and Google Gemini
# ============================================================================

llm_providers:
  anthropic:
    enabled: true
    api_key_env_var: "ANTHROPIC_API_KEY"

    models:
      default: "claude-sonnet-4-5-20250929"
      available:
        - "claude-sonnet-4-5-20250929"
        - "claude-opus-4-1-20250514"
        - "claude-3-5-sonnet-20241022"

    parameters:
      max_tokens: 4096
      temperature: 0.3
      top_p: 0.95
      timeout: 30.0

    rate_limits:
      requests_per_minute: 50
      tokens_per_minute: 100000
      concurrent_requests: 5

    retry_config:
      max_retries: 3
      initial_delay: 1.0
      exponential_backoff: true
      backoff_multiplier: 2.0
      max_delay: 10.0

    performance_targets:
      mean_latency_ms: 500
      p95_latency_ms: 800
      p99_latency_ms: 1200
      error_rate_threshold: 0.01

    features:
      streaming: true
      caching: true
      function_calling: false

  google:
    enabled: true
    api_key_env_var: "GEMINI_API_KEY"

    models:
      default: "gemini-2.5-flash"
      available:
        - "gemini-2.5-flash"
        - "gemini-2.0-flash-exp"
        - "gemini-1.5-pro"

    parameters:
      temperature: 0.2
      top_p: 0.95
      top_k: 40
      timeout: 30.0

    rate_limits:
      requests_per_minute: 60
      concurrent_requests: 10

    retry_config:
      max_retries: 3
      initial_delay: 1.0
      exponential_backoff: true
      backoff_multiplier: 2.0
      max_delay: 10.0

    performance_targets:
      mean_latency_ms: 400
      p95_latency_ms: 600
      p99_latency_ms: 900
      error_rate_threshold: 0.01

    features:
      streaming: true
      caching: false
      function_calling: true

# Fallback configuration
fallback:
  enabled: true
  primary_provider: "anthropic"
  fallback_provider: "google"

  fallback_triggers:
    - "rate_limit_exceeded"
    - "timeout"
    - "service_unavailable"
    - "authentication_error"

  fallback_delay_ms: 100

# Caching configuration
caching:
  enabled: true
  backend: "redis"
  ttl_seconds: 3600

  cache_keys:
    formula_interpretation: "llm:interp:{formula_hash}"
    validation_explanation: "llm:valid:{formula_hash}"

  cache_hit_target: 0.40

# Monitoring and logging
monitoring:
  enable_metrics: true
  enable_tracing: true

  metrics:
    - "latency_ms"
    - "tokens_used"
    - "error_rate"
    - "cache_hit_rate"
    - "fallback_rate"

  logging_level: "INFO"
  log_requests: true
  log_responses: false  # Contains sensitive data

