        pass
        
def prepare_unlabeled_data_multitask(modules, domain,sub_domain,actions, filename, dtype,ner_entity=None,sizefile='sm', val_data=False, test_size=0.2, option=None):
    """
    Prepare data for operations that do not require labeled data.
